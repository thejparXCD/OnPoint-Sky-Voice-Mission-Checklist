{
  "name": "onpoint-sky-voice-mission-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "check": "npm test && npm run build",
    "sync:trello": "node --env-file-if-exists=.env scripts/sync-trello.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "1.25.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "5.2.1",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}

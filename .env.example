# Server-only. Never prefix secrets with VITE_ or commit .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=TWutjvRaJqAX89preB4e
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Required when NODE_ENV=production. Use a strong private passphrase.
APP_ACCESS_CODE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Alternative to ELEVENLABS_API_KEY: keep the ElevenLabs credential inside n8n.
# Import n8n/voice-bridge.json, configure its credentials, test, then publish it.
N8N_VOICE_BASE_URL=
N8N_VOICE_SECRET=
# If Cloudflare Access protects the webhook, use a scoped service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Your HTTPS app address in production, no trailing slash.
APP_ORIGIN=http://localhost:5173
PORT=3001
# Optional read-only Trello credentials for refreshing templates.
TRELLO_API_KEY=
TRELLO_TOKEN=
